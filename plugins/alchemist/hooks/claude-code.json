{
  "description": "Shows the user the build's phase when an Alchemist step moves it to a new one.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_alchemist_alchemist|claude_ai_Alchemist)__alchemist_(do|answer)$",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/phase-line.sh\"", "timeout": 5}]
      }
    ]
  }
}
